<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_auth"
app:startDestination="@id/loginFragment" >
<fragment
    android:id="@+id/loginFragment"
    android:name="com.tdtu.mobilebanking.auth.ui.LoginFragment"
    android:label="Đăng nhập"
    tools:layout="@layout/fragment_login" >

    <action
        android:id="@+id/action_login_to_register"
        app:destination="@id/registerFragment" />
    <action
        android:id="@+id/action_login_to_forgot"
        app:destination="@id/forgotPasswordFragment" />
    <action
        android:id="@+id/action_login_to_home"
        app:destination="@id/nav_account"
        app:popUpTo="@id/nav_auth"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_login_to_officer_home"
        app:destination="@id/nav_officer"
        app:popUpTo="@id/nav_auth"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/registerFragment"
    android:name="com.tdtu.mobilebanking.auth.ui.RegisterFragment"
    android:label="Đăng ký"
    tools:layout="@layout/fragment_register" >

    <action
        android:id="@+id/action_register_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/loginFragment"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/forgotPasswordFragment"
    android:name="com.tdtu.mobilebanking.auth.ui.ForgotPasswordFragment"
    android:label="Quên mật khẩu"
    tools:layout="@layout/fragment_forgot_password" >

    <action
        android:id="@+id/action_forgot_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/loginFragment"
        app:popUpToInclusive="true" />

</fragment>
</navigation>