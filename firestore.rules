rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isOfficer() {
      return signedIn() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'officer';
    }
    function accPath(id) { return /databases/$(db)/documents/accounts/$(id); }
    function txPath(id)  { return /databases/$(db)/documents/transactions/$(id); }
    function changed()   { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isNewTx(id) { return !exists(txPath(id)) && existsAfter(txPath(id)); }

    function validDebit(accId) {
      let t = getAfter(txPath(request.resource.data.lastTxId)).data;
      return t.fromAccountId == accId
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'ACTIVE'
        && t.createdBy == request.auth.uid
        && request.resource.data.balance == resource.data.balance - t.amount
        && request.resource.data.balance >= 0;
    }

    function validCredit(accId) {
      let t = getAfter(txPath(request.resource.data.lastTxId)).data;
      return t.toAccountId == accId
        && t.createdBy == request.auth.uid
        && request.resource.data.balance == resource.data.balance + t.amount
        && (
          (t.fromAccountId != null
            && getAfter(accPath(t.fromAccountId)).data.lastTxId == request.resource.data.lastTxId)
          || (t.type == 'DEPOSIT_GATEWAY' && t.fromAccountId == null
              && resource.data.ownerId == request.auth.uid && t.amount <= 50000000)
          || (t.type == 'COUNTER_DEPOSIT' && t.fromAccountId == null && isOfficer())
        );
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOfficer());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.kycStatus == 'PENDING';
      allow create: if isOfficer() && request.resource.data.role == 'customer';
      allow update: if signedIn() && request.auth.uid == uid
        && changed().hasOnly(['phone', 'address', 'email', 'mustChangePassword', 'pinHash', 'kycStatus'])
        && (!('mustChangePassword' in changed()) || request.resource.data.mustChangePassword == false)
        && (!('kycStatus' in changed()) || request.resource.data.kycStatus in ['VERIFIED', 'PENDING']);
      allow update: if isOfficer() && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ---------- accounts ----------
    match /accounts/{accId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isOfficer());
      allow create: if isOfficer()
        && request.resource.data.balance == 0
        && request.resource.data.lastTxId == null
        && existsAfter(/databases/$(db)/documents/users/$(request.resource.data.ownerId));
      allow update: if changed().hasOnly(['status', 'dailyLimit']) && isOfficer();
      allow update: if signedIn()
        && changed().hasOnly(['balance', 'lastTxId'])
        && isNewTx(request.resource.data.lastTxId)
        && (validDebit(accId) || validCredit(accId));
      allow delete: if false;
    }

    // ---------- accountDirectory ----------
    match /accountDirectory/{accountNumber} {
      allow get:    if signedIn();
      allow list:   if isOfficer();
      allow create: if isOfficer();
      allow update: if isOfficer() && request.resource.data.accountId == resource.data.accountId;
      allow delete: if false;
    }

    // ---------- transactions ----------
    match /transactions/{txId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || isOfficer());
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['type','fromAccountId','toAccountId','amount',
                                                'createdBy','participants','status','createdAt'])
        && request.resource.data.type in ['DEPOSIT_GATEWAY','COUNTER_DEPOSIT','WITHDRAW',
             'TRANSFER_INTERNAL','TRANSFER_EXTERNAL','BILL','TOPUP_PHONE','CHECKOUT',
             'SAVING_DEPOSIT','MORTGAGE_PAYMENT']
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.createdAt == request.time
        && !(request.resource.data.fromAccountId == null && request.resource.data.toAccountId == null)
        && request.resource.data.fromAccountId != request.resource.data.toAccountId
        && (request.resource.data.fromAccountId == null
            || getAfter(accPath(request.resource.data.fromAccountId)).data.lastTxId == txId)
        && (request.resource.data.toAccountId == null
            || getAfter(accPath(request.resource.data.toAccountId)).data.lastTxId == txId);
      allow update, delete: if false;
    }

    // ---------- rates ----------
    match /rates/{productId} {
      allow read: if signedIn();
      allow write: if isOfficer();
    }

    // ---------- kyc ----------
    match /kyc/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOfficer());
      // Customer can create/update their own KYC doc (face enroll, CCCD scan)
      allow write: if signedIn() && (request.auth.uid == uid || isOfficer());
    }

    // ---------- profileRequests ----------
    match /profileRequests/{reqId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isOfficer());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update: if isOfficer()
        && changed().hasOnly(['status','reason','reviewedBy','reviewedAt']);
      allow delete: if false;
    }

    // ---------- config ----------
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
